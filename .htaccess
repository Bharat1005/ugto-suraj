# ==============================================================================
# UGTO SURAJ — Clean Apache / cPanel Redirection (No Redirect Loops)
# ==============================================================================

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Cloudflare / Reverse-Proxy Safe HTTPS Redirect (Avoids Flexible SSL Loops)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP:CF-Visitor} !'"scheme":"https"'
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # 2. NEVER redirect root "/" or "index.html"
  RewriteRule ^$ index.html [L]
  RewriteRule ^index\.html$ - [L]

  # 3. Allow real files and directories (assets, css, js, images) to load directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Redirect any other subpaths (e.g. /veserv, /ppp) back to homepage
  RewriteCond %{REQUEST_URI} !^/?$
  RewriteRule ^.+/?$ https://%{HTTP_HOST}/ [R=301,L]
</IfModule>

# Fallback: Serve index.html on 404 errors
ErrorDocument 404 /index.html
